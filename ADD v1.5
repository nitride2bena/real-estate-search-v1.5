## **3. 데이터베이스(DB) 설계 및 DDL 스크립트 (PostGIS)**

### **3.1. 설계 핵심 원칙**
1. **법정동 코드 표준화:** 건축물대장·토지대장·실거래가 데이터와 1:1 매핑을 위해 **10자리 법정동 코드(`bjd_code`)**를 기본 키로 사용합니다. (시도: 앞 2자리, 시군구: 앞 5자리, 읍면동: 앞 8자리)
2. **좌표계 통일:** 모든 공간 컬럼은 글로벌 웹 지도 표준인 **WGS84 (`SRID 4326`)**로 저장합니다.
3. **사전 계산 컬럼 활용:** 실시간 뷰포트 정렬(`fitBounds`)을 위한 `bbox`와 실시간 평당 단가 검색을 위한 `price_per_pyeong`을 사전 계산하여 런타임 연산 부하를 제거합니다.

### **3.2. PostgreSQL / PostGIS DDL 스크립트**
```sql
CREATE EXTENSION IF NOT EXISTS postgis;

-- 1. 행정구역 코드 및 공간 경계 테이블 (regions)
CREATE TABLE regions (
    bjd_code            VARCHAR(10) PRIMARY KEY,            -- 법정동 코드 10자리 (예: '4311110100')
    region_name         VARCHAR(100) NOT NULL,              -- 행정구역 명칭 (예: '충청북도 청주시 상당구 북문로1가')
    short_name          VARCHAR(50) NOT NULL,               -- UI 표기용 단축명 (예: '북문로1가', 통합시의 경우 '청주시 상당구')
    region_depth        SMALLINT NOT NULL,                  -- 계층 깊이 (1: 시도, 2: 시군구, 3: 읍면동)
    parent_code         VARCHAR(10) REFERENCES regions(bjd_code),
    center_point        GEOMETRY(Point, 4326) NOT NULL,     -- 라벨 및 초기 포커싱용 중심 좌표
    bbox                DOUBLE PRECISION[4] NOT NULL,       -- fitBounds 연산용 [minLng, minLat, maxLng, maxLat]
    boundary_original   GEOMETRY(MultiPolygon, 4326),       -- 원본 정밀 행정구역 경계
    boundary_simplified GEOMETRY(MultiPolygon, 4326),       -- Douglas-Peucker 단순화 경량 경계 (API 응답용)
    updated_at          TIMESTAMPTZ DEFAULT NOW()
);

CREATE INDEX idx_regions_depth_parent ON regions (region_depth, parent_code);
CREATE INDEX idx_regions_geom_simplified ON regions USING GIST (boundary_simplified);

-- 2. 매물 정보 및 검색 필터 테이블 (properties)
CREATE TABLE properties (
    property_id         BIGSERIAL PRIMARY KEY,
    bjd_code            VARCHAR(10) NOT NULL REFERENCES regions(bjd_code),
    sido_code           VARCHAR(2) GENERATED ALWAYS AS (SUBSTRING(bjd_code, 1, 2)) STORED,
    sigungu_code        VARCHAR(5) GENERATED ALWAYS AS (SUBSTRING(bjd_code, 1, 5)) STORED,
    eupmyeondong_code   VARCHAR(8) GENERATED ALWAYS AS (SUBSTRING(bjd_code, 1, 8)) STORED,
    
    -- 면적 및 규모 (㎡ 기준 저장, 프론트엔드에서 평/㎡ 변환)
    land_area_sqm       NUMERIC(12, 2) NOT NULL DEFAULT 0,
    building_area_sqm   NUMERIC(12, 2) NOT NULL DEFAULT 0,
    
    -- 용도지역 및 건축물 용도 (필지 내 다중 용도지역 수용을 위해 배열 타입 사용)
    land_use_zones      VARCHAR(20)[] NOT NULL,
    building_main_use   VARCHAR(20) NOT NULL,
    
    -- 거래유형 및 가격 지표
    trade_type          VARCHAR(10) NOT NULL,               -- 'SALE': 매매, 'JEONSE': 전세, 'MONTHLY': 월세
    price               BIGINT NOT NULL DEFAULT 0,          -- 매매가 또는 전세/월세 보증금 (만원)
    monthly_rent        BIGINT NOT NULL DEFAULT 0,          -- 월차임 (만원)
    price_per_pyeong    BIGINT NOT NULL DEFAULT 0,          -- 평당 단가 (만원, 사전 계산)
    
    location            GEOMETRY(Point, 4326) NOT NULL,
    status              VARCHAR(20) NOT NULL DEFAULT 'ACTIVE',
    created_at          TIMESTAMPTZ DEFAULT NOW()
);

-- 실시간 매물 건수 집계(POST /count) 최적화를 위한 복합 인덱스 및 GIN 인덱스
CREATE INDEX idx_properties_filter_main ON properties (status, trade_type, eupmyeondong_code, price);
CREATE INDEX idx_properties_area ON properties (land_area_sqm, building_area_sqm);
CREATE INDEX idx_properties_pyeong ON properties (price_per_pyeong);
CREATE INDEX idx_properties_zoning_gin ON properties USING GIN (land_use_zones);
CREATE INDEX idx_properties_bldg_use ON properties (building_main_use);
CREATE INDEX idx_properties_location ON properties USING GIST (location);
```

